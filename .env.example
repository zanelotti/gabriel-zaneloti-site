# Copie este arquivo para ".env" e preencha apenas os IDs das plataformas que
# você realmente utiliza. Nenhum valor é obrigatório — o site funciona
# normalmente sem analytics configurado.

# Google Analytics 4 (ex: G-XXXXXXXXXX)
VITE_GA4_MEASUREMENT_ID=

# Google Ads — ID de conversão (ex: AW-XXXXXXXXX)
VITE_GOOGLE_ADS_CONVERSION_ID=

# Meta Pixel (ex: 000000000000000)
VITE_META_PIXEL_ID=
