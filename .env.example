# Copie este arquivo para ".env" e preencha apenas os IDs das plataformas que
# você realmente utiliza. Nenhum valor é obrigatório — o site funciona
# normalmente sem analytics configurado.

# Google Analytics 4 (ex: G-XXXXXXXXXX)
VITE_GA4_MEASUREMENT_ID=

# Google Ads — ID de conversão (ex: AW-XXXXXXXXX)
VITE_GOOGLE_ADS_CONVERSION_ID=

# Google Ads — rótulo da ação de conversão "Envio de simulação" (criada em
# Ferramentas e configurações > Conversões, dentro da sua conta do Google Ads).
# Sem isso, o Google Ads NÃO contabiliza a conversão mesmo com o ID acima preenchido.
VITE_GOOGLE_ADS_LEAD_LABEL=

# Google Ads — rótulo da ação de conversão "Clique no WhatsApp" (opcional,
# só se você quiser esse clique como uma conversão secundária).
VITE_GOOGLE_ADS_WHATSAPP_LABEL=

# Meta Pixel (ex: 000000000000000)
VITE_META_PIXEL_ID=

# Google Tag Manager: NÃO usa variável de ambiente. O snippet oficial (fornecido
# pelo gestor de tráfego) já está fixo em todas as páginas HTML do site (ver
# README, seção "Analytics"). Para trocar de container no futuro, edite
# diretamente o ID nos arquivos .html (busque por "GTM-").

# Senha simples (opcional) para a página interna /calculo.html.
# NÃO é segurança de verdade — veja a seção sobre a calculadora interna no README.
VITE_CALCULO_PASSCODE=

# CRM interno (/crm.html) — Project URL e chave "anon public" do Supabase
# (Settings → API Keys no painel do Supabase). Essas duas são seguras para
# ficar no navegador: o acesso real é protegido por RLS + login (Supabase
# Auth), não por essas chaves. NUNCA coloque a chave "service_role" aqui —
# essa fica só nas variáveis de ambiente do Vercel (SUPABASE_SERVICE_ROLE_KEY),
# usada pela função /api/notify-lead.js.
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Google Ads — rótulo da ação de conversão "Consultoria agendada" (Conversões >
# Nova ação de conversão > Site). Dispara quando alguém conclui o agendamento
# da consultoria gratuita. Sem isso, o Google Ads não contabiliza o agendamento.
VITE_GOOGLE_ADS_SCHEDULE_LABEL=

# ----------------------------------------------------------------------------
# Agendamento da consultoria gratuita — SOMENTE no painel da Vercel
# (Settings > Environment Variables). NUNCA coloque estas no .env do navegador.
# ----------------------------------------------------------------------------
# Conta de serviço do Google (cole o conteúdo inteiro do arquivo .json da chave)
# GOOGLE_SERVICE_ACCOUNT_JSON=
# E-mail da sua agenda (a que foi compartilhada com a conta de serviço)
# GOOGLE_CALENDAR_ID=comercial.mfzeng@gmail.com
# Link fixo de reunião (Meet/Zoom) — opcional; sem ele a reunião é por WhatsApp
# AGENDA_VIDEO_LINK=
# Remetente de um domínio verificado no Resend, para mandar a confirmação à
# pessoa por e-mail — opcional
# AGENDA_EMAIL_FROM=
# Ajustes de horário — opcionais (padrões entre parênteses)
# AGENDA_WORKING_DAYS=1,2,3,4,5               (0=dom ... 6=sáb)
# AGENDA_WORKING_HOURS=09:00-12:00,14:00-18:00
# AGENDA_SLOT_MINUTES=15
# AGENDA_MEETING_MINUTES=10
# AGENDA_DAYS_AHEAD=14
# AGENDA_MIN_NOTICE_HOURS=2
