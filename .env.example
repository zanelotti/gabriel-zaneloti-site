# Copie este arquivo para ".env" e preencha apenas os IDs das plataformas que
# você realmente utiliza. Nenhum valor é obrigatório — o site funciona
# normalmente sem analytics configurado.

# Google Analytics 4 (ex: G-XXXXXXXXXX)
VITE_GA4_MEASUREMENT_ID=

# Google Ads — ID de conversão (ex: AW-XXXXXXXXX)
VITE_GOOGLE_ADS_CONVERSION_ID=

# Google Ads — rótulo da ação de conversão "Envio de simulação" (criada em
# Ferramentas e configurações > Conversões, dentro da sua conta do Google Ads).
# Sem isso, o Google Ads NÃO contabiliza a conversão mesmo com o ID acima preenchido.
VITE_GOOGLE_ADS_LEAD_LABEL=

# Google Ads — rótulo da ação de conversão "Clique no WhatsApp" (opcional,
# só se você quiser esse clique como uma conversão secundária).
VITE_GOOGLE_ADS_WHATSAPP_LABEL=

# Meta Pixel (ex: 000000000000000)
VITE_META_PIXEL_ID=

# Senha simples (opcional) para a página interna /calculo.html.
# NÃO é segurança de verdade — veja a seção sobre a calculadora interna no README.
VITE_CALCULO_PASSCODE=
