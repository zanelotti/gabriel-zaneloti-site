# ============================================================================
#  Configuração do bot. Copie este arquivo para ".env" (sem o .example) e preencha.
#  NUNCA envie o arquivo .env para o GitHub: ele tem chaves secretas.
# ============================================================================

# --- Obrigatórias ---------------------------------------------------------
# Supabase (as mesmas do projeto no Vercel): Supabase -> Project Settings -> API
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Chave da API da Anthropic (console.anthropic.com -> API Keys)
ANTHROPIC_API_KEY=

# --- Recomendadas ---------------------------------------------------------
# Mesma chave do Resend usada no site: é por ela que o bot te avisa por e-mail
RESEND_API_KEY=
LEAD_NOTIFICATION_EMAIL=comercial.mfzeng@gmail.com

# Endereço do site (usado para consultar horários e agendar a consultoria)
SITE_URL=https://www.gabrielzaneloti.com.br

# --- Teste (use na primeira vez!) -----------------------------------------
# Se preenchido, o bot SÓ fala com estes números (DDD + número, separados por vírgula).
# Deixe vazio em produção.
LISTA_TESTE=
# Coloque 1 para o bot só escrever no console o que enviaria, sem usar o WhatsApp.
MODO_TESTE=0

# --- Ajustes (opcionais) --------------------------------------------------
# Modelo do Claude usado nas conversas
# ANTHROPIC_MODEL=claude-sonnet-5-5
# Abaixo desta economia estimada (R$) o bot não oferece reunião: passa para você conversar por texto
# ECONOMIA_MIN_PARA_REUNIAO=5000
# Trava de segurança: máximo de mensagens do bot em 24h
# TETO_MENSAGENS_24H=120
# Segundos que o bot espera o lead terminar de escrever antes de responder (em milissegundos)
# DEBOUNCE_MS=15000
